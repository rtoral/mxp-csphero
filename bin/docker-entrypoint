#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# NOTE: migrations are intentionally NOT run here. When several web/worker pods
# share one database, running db:prepare per-pod races on every deploy. Run
# migrations exactly once per release via the dedicated `migrate` service
# (docker compose) or an init container / Job (Kubernetes) before starting the
# app pods. See docker-compose.yml.

exec "${@}"
